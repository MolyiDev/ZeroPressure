{
    "name": "ZeroPressure",
    "tree": {
        "$className": "DataModel",
        "Workspace": {
            "$className": "Workspace",
            "$ignoreUnknownInstances": true,
            "Temporal": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true
            }
        },
        "Lighting": {
            "$className": "Lighting",
            "$ignoreUnknownInstances": true,
            "Blur": {
                "$className": "BlurEffect",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Size": 0
                }
            },
            "ColorCorrection": {
                "$className": "ColorCorrectionEffect",
                "$ignoreUnknownInstances": true
            }
        },
        "ReplicatedFirst": {
            "$className": "ReplicatedFirst",
            "$ignoreUnknownInstances": true,
            "FirstShared": {
                "$path": "src/FirstShared"
            }
        },
        "ReplicatedStorage": {
            "Animations": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true
            },
            "Packages": {
                "$path": "Packages"
            },
            "Shared": {
                "$ignoreUnknownInstances": true,
                "$path": "src/Shared"
            },
            "Types": {
                "$path": "src/Types"
            },
            "Events": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true,
                "Test": {
                    "$className": "RemoteEvent",
                    "$ignoreUnknownInstances": true
                }
            }
        },
        "ServerScriptService": {
            "$ignoreUnknownInstances": true,
            "Server": {
                "$ignoreUnknownInstances": true,
                "$path": "src/Server"
            }
        },
        "StarterPlayer": {
            "$ignoreUnknownInstances": true,
            "StarterPlayerScripts": {
                "$ignoreUnknownInstances": true,
                "Client": {
                    "$ignoreUnknownInstances": true,
                    "$path": "src/Client"
                }
            }
        },
        "SoundService": {
            "$className": "SoundService",
            "$ignoreUnknownInstances": true,
            "Effects": {
                "$className": "SoundGroup",
                "$ignoreUnknownInstances": true
            },
            "Music": {
                "$className": "SoundGroup",
                "$ignoreUnknownInstances": true
            },
            "UI": {
                "$className": "SoundGroup",
                "$ignoreUnknownInstances": true
            }
        }
    }
}
